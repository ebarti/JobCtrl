# JobCtrl Environment Configuration
# Copy to ~/.jobctrl/.env for personal use. Keep real values out of git.

# Configure at least one provider. Settings -> Credentials is preferred on macOS.
# One ready provider is sufficient; a second is optional.

# Codex: authenticate the stable JobCtrl-owned CLI home. Do not put an OpenAI
# key here for direct runtime use. Run `jobctrl setup --launch-logins`, or:
# CODEX_HOME="${JOBCTRL_DIR:-$HOME/.jobctrl}/codex_home" codex login
# printenv OPENAI_API_KEY | CODEX_HOME="${JOBCTRL_DIR:-$HOME/.jobctrl}/codex_home" codex login --with-api-key

# Claude: choose exactly one route.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_VERTEX_PROJECT_ID=
# CLOUD_ML_REGION=global
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_ANTHROPIC_AWS=1
# ANTHROPIC_AWS_WORKSPACE_ID=
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_RESOURCE=
# AWS_PROFILE=
# AWS_REGION=

# Google: Gemini key or Vertex AI Application Default Credentials.
GEMINI_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional provider/model policy.
# LLM_MODEL=
# JOBCTRL_ANALYSIS_LEGS=claude,codex,antigravity
# JOBCTRL_CODEX_BIN=      # Explicit runtime override; bundled pin is default

# Local runtime (optional)
# JOBCTRL_DIR=~/.jobctrl
# JOBCTRL_DB_PATH=~/.jobctrl/jobctrl.db
# JOBCTRL_API_HOST=127.0.0.1
# JOBCTRL_API_PORT=8766
# JOBCTRL_API_ALLOW_REMOTE_BIND=0
# JOBCTRL_WEB_PORT=5173
# JOBCTRL_TEMPORAL_DB=.dev/temporal/temporal.db

# Resume tailoring quality controls (optional)
# TAILORING_GENERATOR_MODELS=default
# TAILORING_JUDGE_MODEL=default
# TAILORING_JUDGE_MIN_SCORE=0.82

# Browser and artifact tooling (optional)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Local web UI (optional)
# VITE_GOOGLE_MAPS_API_KEY=  # Enables Google Maps address search in Profile.

# Crawl politeness (optional; conservative fail-closed defaults apply if unset).
# The default outbound identity is honest: JobCtrl/<version> (+<repo url>).
# It NEVER impersonates a browser on a surface we control. Review it before real
# crawls; override the product token and/or contact below (set the contact empty
# to drop the "(+contact)" suffix). See docs/user/configuration.md.
# JOBCTRL_CRAWL_UA_PRODUCT=JobCtrl
# JOBCTRL_CRAWL_UA_CONTACT=https://github.com/ebarti/JobCtrl

# Apply automation (optional, explicit user authorization still required)
# JOBCTRL_CLAUDE_BIN=   # Explicit apply-agent Claude runtime override; PATH/bundled fallback is default
# JOBCTRL_APPLY_TIMEOUT_SECONDS=900
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Gmail connector (optional, read plus approval-bound application-send scopes)
# JOBCTRL_GMAIL_DIR=~/.jobctrl/gmail
# JOBCTRL_GMAIL_OAUTH_CLIENT_PATH=~/.jobctrl/gmail/oauth-client.json
# JOBCTRL_GMAIL_TOKEN_PATH=~/.jobctrl/gmail/token.json

# Observability (optional)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# LANGFUSE_DISABLE=1

# Temporal (optional; defaults match `temporal server start-dev`)
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# JOBCTRL_MAX_CONCURRENT_ACTIVITIES=4
