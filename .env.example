# JobCtrl Environment Configuration
# Copy to ~/.jobctrl/.env for personal use. Keep real values out of git.
# Contributors: development topology, ports, Vite/build variables, and test
# overrides live in docs/local-development.md, not in this installed-user file.

# Configure at least one provider. Settings -> Credentials is preferred on macOS.
# One ready provider is sufficient; a second is optional.

# Codex: use an authenticated Codex CLI. API-key users may authenticate through
# Codex's `codex login --with-api-key` flow.

# Claude: choose exactly one route.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_VERTEX_PROJECT_ID=
# CLOUD_ML_REGION=global
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_ANTHROPIC_AWS=1
# ANTHROPIC_AWS_WORKSPACE_ID=
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_RESOURCE=
# AWS_PROFILE=
# AWS_REGION=

# Google: Gemini key or Vertex AI Application Default Credentials.
# GEMINI_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional provider/model policy.
# LLM_MODEL=
# JOBCTRL_ANALYSIS_LEGS=claude,codex,antigravity

# Local data location (optional; set before starting JobCtrl)
# JOBCTRL_DIR=~/.jobctrl

# Resume tailoring quality controls (optional)
# TAILORING_GENERATOR_MODELS=default
# TAILORING_JUDGE_MODEL=default
# TAILORING_JUDGE_MIN_SCORE=0.82

# Crawl politeness (optional; conservative fail-closed defaults apply if unset).
# The default outbound identity is honest: JobCtrl/<version> (+<repo url>).
# It NEVER impersonates a browser on a surface we control. Review it before real
# crawls; override the product token and/or contact below (set the contact empty
# to drop the "(+contact)" suffix). See docs/user/configuration.md.
# JOBCTRL_CRAWL_UA_PRODUCT=JobCtrl
# JOBCTRL_CRAWL_UA_CONTACT=https://github.com/ebarti/JobCtrl

# Apply automation (optional; Settings is preferred for timeout/budget controls
# and, on macOS, the CapSolver Keychain entry. Environment values make matching
# controls read-only. Configuring a solver explicitly authorizes supported
# CAPTCHA requests during apply runs you start or a standing loop you enable.)
# JOBCTRL_APPLY_TIMEOUT_SECONDS=900
# CAPSOLVER_API_KEY=

# Gmail connector (optional; requires a Google OAuth Desktop client, then
# `jobctrl gmail-auth`; requests gmail.readonly and gmail.send)
# JOBCTRL_GMAIL_DIR=~/.jobctrl/gmail
# JOBCTRL_GMAIL_OAUTH_CLIENT_PATH=~/.jobctrl/gmail/oauth-client.json
# JOBCTRL_GMAIL_TOKEN_PATH=~/.jobctrl/gmail/token.json

# Observability (optional, metadata-only spans; never raw prompts/completions)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# LANGFUSE_DISABLE=1
