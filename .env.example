# JobHunter Environment Configuration
# Copy to ~/.jobhunter/.env for personal use. Keep real values out of git.

# LLM provider for scoring/materials helper calls (pick one)
GEMINI_API_KEY=           # Gemini 3.5 Flash by default; also feeds the Antigravity leg
# OPENAI_API_KEY=         # OpenAI helper calls; enroll it into Codex auth.json for the Codex leg
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override model name

# Employer-analysis ensemble auth.
# Run `uv --project workers/automation run jobhunter setup` to detect/enroll.
# ANTHROPIC_API_KEY=      # Supported Claude Agent SDK path
# CLAUDE_CODE_OAUTH_TOKEN= # Local/dev Claude subscription convenience
# CODEX_HOME=~/.codex     # Codex leg needs CODEX_HOME/auth.json, not a bare env key
# JOBHUNTER_ANALYSIS_LEGS=claude,codex,antigravity
# GOOGLE_API_KEY=         # Fallback for Antigravity when GEMINI_API_KEY is unset
# GOOGLE_GENAI_USE_VERTEXAI=0
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
# JOBHUNTER_CODEX_BIN=    # Explicit Codex runtime override; bundled pin is default

# Local runtime (optional)
# JOBHUNTER_DIR=~/.jobhunter
# JOBHUNTER_DB_PATH=~/.jobhunter/jobhunter.db
# JOBHUNTER_API_HOST=127.0.0.1
# JOBHUNTER_API_PORT=8766
# JOBHUNTER_API_ALLOW_REMOTE_BIND=0
# JOBHUNTER_WEB_PORT=5173
# JOBHUNTER_TEMPORAL_DB=.dev/temporal/temporal.db

# Resume tailoring quality controls (optional)
# TAILORING_GENERATOR_MODELS=local:draft-a,gemini:gemini-3.5-flash
# TAILORING_JUDGE_MODEL=gemini:gemini-3.5-flash
# TAILORING_JUDGE_MIN_SCORE=0.82
# JOBHUNTER_RESUME_RENDERER=html_pdf

# Browser and artifact tooling (optional)
# PDFLATEX_PATH=/Library/TeX/texbin/pdflatex
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Local web UI (optional)
# VITE_GOOGLE_MAPS_API_KEY=  # Enables Google Maps address search in Profile.

# Crawl politeness (optional; conservative fail-closed defaults apply if unset).
# The default outbound identity is honest: JobHunter/<version> (+<repo url>).
# It NEVER impersonates a browser on a surface we control. Review it before real
# crawls; override the product token and/or contact below (set the contact empty
# to drop the "(+contact)" suffix). See docs/user/configuration.md.
# JOBHUNTER_CRAWL_UA_PRODUCT=JobHunter
# JOBHUNTER_CRAWL_UA_CONTACT=https://github.com/ebarti/JobHunter

# Apply automation (optional, explicit user authorization still required)
# JOBHUNTER_CLAUDE_BIN=   # Explicit apply-agent Claude runtime override; PATH/bundled fallback is default
# JOBHUNTER_APPLY_TIMEOUT_SECONDS=900
CAPSOLVER_API_KEY=        # For CAPTCHA solving during auto-apply

# Gmail outcome connector (optional, read-only scope)
# JOBHUNTER_GMAIL_DIR=~/.jobhunter/gmail
# JOBHUNTER_GMAIL_OAUTH_CLIENT_PATH=~/.jobhunter/gmail/oauth-client.json
# JOBHUNTER_GMAIL_TOKEN_PATH=~/.jobhunter/gmail/token.json

# Observability (optional)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# LANGFUSE_DISABLE=1

# Temporal (optional; defaults match `temporal server start-dev`)
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# JOBHUNTER_MAX_CONCURRENT_ACTIVITIES=4
