{
  "schemaVersion": 2,
  "launcherProtocol": 2,
  "ports": {
    "api": 8766
  },
  "components": [
    {
      "name": "postgres",
      "executable": "postgres/bin/postgres",
      "arguments": [
        "-D",
        "${PGDATA}",
        "-c",
        "listen_addresses=",
        "-c",
        "unix_socket_directories=${PGSOCKET}",
        "-c",
        "unix_socket_permissions=0700",
        "-p",
        "5432"
      ]
    },
    {
      "name": "worker",
      "executable": "python/bin/python3",
      "arguments": [
        "-I",
        "-B",
        "-m",
        "jobctrl.app.worker",
        "--workspace",
        "${STATE_DIR}"
      ]
    },
    {
      "name": "api",
      "executable": "python/bin/python3",
      "arguments": [
        "-I",
        "-B",
        "-m",
        "jobctrl.app.server",
        "--workspace",
        "${STATE_DIR}",
        "--host",
        "127.0.0.1",
        "--port",
        "${API_PORT}",
        "--static-dir",
        "${PAYLOAD_ROOT}/web"
      ]
    }
  ],
  "health": {
    "postgres": {
      "executable": "postgres/bin/psql",
      "arguments": [
        "-XAtw",
        "-h",
        "${PGSOCKET}",
        "-p",
        "5432",
        "-U",
        "jobctrl",
        "-d",
        "postgres",
        "-c",
        "SHOW data_directory"
      ]
    },
    "api": {
      "path": "/v1/health",
      "requireWorkerHealthy": true,
      "requireWorkerPid": true
    }
  }
}
