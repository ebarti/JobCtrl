{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobctrl.dev/schemas/runtime-manifest-v2.json",
  "title": "JobCtrl launcher runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "launcherProtocol",
    "ports",
    "components",
    "health"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "launcherProtocol": {
      "const": 2
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api"
      ],
      "properties": {
        "api": {
          "const": 8766
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "executable",
          "arguments"
        ],
        "properties": {
          "name": {
            "enum": [
              "postgres",
              "worker",
              "api"
            ]
          },
          "executable": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "const": "api"
                }
              }
            },
            "then": {
              "properties": {
                "executable": {
                  "const": "python/bin/python3"
                },
                "arguments": {
                  "contains": {
                    "const": "jobctrl.app.server"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "name": {
                  "const": "worker"
                }
              }
            },
            "then": {
              "properties": {
                "executable": {
                  "const": "python/bin/python3"
                },
                "arguments": {
                  "contains": {
                    "const": "jobctrl.app.worker"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgres",
        "api"
      ],
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "requireWorkerHealthy",
            "requireWorkerPid"
          ],
          "properties": {
            "path": {
              "const": "/v1/health"
            },
            "requireWorkerHealthy": {
              "const": true
            },
            "requireWorkerPid": {
              "const": true
            }
          }
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "arguments"
          ],
          "properties": {
            "arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "executable": {
              "const": "postgres/bin/psql"
            }
          }
        }
      }
    }
  }
}
