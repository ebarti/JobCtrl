{
  "name": "jobctrl",
  "version": "2.0.0",
  "private": true,
  "description": "AI-powered end-to-end job application pipeline",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "scripts/dev run",
    "install:interactive": "scripts/install",
    "dev:setup": "scripts/dev setup",
    "dev:start": "scripts/dev start",
    "dev:status": "scripts/dev status",
    "dev:stop": "scripts/dev stop",
    "dev:logs": "scripts/dev logs",
    "api:dev": "corepack pnpm --filter @jobctrl/api dev",
    "api:start": "corepack pnpm --filter @jobctrl/api start",
    "api:check": "corepack pnpm --filter @jobctrl/api check",
    "api:test": "corepack pnpm --filter @jobctrl/api test",
    "web:check": "corepack pnpm --filter @jobctrl/web check",
    "web:dev": "corepack pnpm --filter @jobctrl/web dev",
    "web:build": "corepack pnpm --filter @jobctrl/web build",
    "web:preview": "corepack pnpm --filter @jobctrl/web preview",
    "web:test": "corepack pnpm --filter @jobctrl/web test",
    "web:test:watch": "corepack pnpm --filter @jobctrl/web test:watch",
    "web:test:coverage": "corepack pnpm --filter @jobctrl/web test:coverage",
    "web:test-d": "corepack pnpm --filter @jobctrl/web test-d",
    "web:e2e": "corepack pnpm --filter @jobctrl/web e2e",
    "web:e2e:headed": "corepack pnpm --filter @jobctrl/web e2e:headed",
    "web:storybook": "corepack pnpm --filter @jobctrl/web storybook",
    "web:storybook:build": "corepack pnpm --filter @jobctrl/web storybook:build",
    "web:storybook:test": "corepack pnpm --filter @jobctrl/web storybook:test",
    "demo:dev": "scripts/dev run demo-api demo-web",
    "demo:start": "scripts/dev start demo-api demo-web",
    "demo:status": "scripts/dev status demo-api demo-web",
    "demo:stop": "scripts/dev stop demo-api demo-web",
    "demo:build": "VITE_JOBCTRL_APP_MODE=demo corepack pnpm --filter @jobctrl/web build",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "demo-edge:check": "corepack pnpm --filter @jobctrl/demo-edge check",
    "demo-edge:test": "corepack pnpm --filter @jobctrl/demo-edge test",
    "demo-edge:types": "corepack pnpm --filter @jobctrl/demo-edge types",
    "demo-edge:dry-run": "corepack pnpm --filter @jobctrl/demo-edge dry-run",
    "demo-edge:migrate:local": "corepack pnpm --filter @jobctrl/demo-edge migrate:local",
    "extension:check": "corepack pnpm --filter @jobctrl/extension check",
    "extension:test": "corepack pnpm --filter @jobctrl/extension test",
    "extension:build": "corepack pnpm --filter @jobctrl/extension build",
    "extension:e2e": "corepack pnpm --filter @jobctrl/extension e2e",
    "qa:seed": "corepack pnpm --filter @jobctrl/api qa:seed",
    "qa:test": "corepack pnpm --filter @jobctrl/api qa:test",
    "docs:screenshots": "JOBCTRL_DOCS_SCREENSHOTS=1 corepack pnpm --filter @jobctrl/web e2e -- tests/docs-screenshots.spec.ts",
    "docs:dev": "scripts/dev run docs",
    "docs:start": "scripts/dev start docs",
    "docs:status": "scripts/dev status docs",
    "docs:stop": "scripts/dev stop docs",
    "docs:build": "node scripts/check-install-asset.mjs && vitepress build docs && node scripts/check-docs-site-links.mjs",
    "docs:check:runtime": "node scripts/check-docs-site-runtime.mjs",
    "docs:preview": "vitepress preview docs",
    "distribution:audit": "node scripts/distribution-provider-lock.mjs check && node scripts/distribution-manifest.mjs audit && node scripts/distribution-build.mjs audit",
    "distribution:build:fixture": "node scripts/distribution-build.mjs fixture",
    "distribution:build": "node scripts/distribution-build.mjs real",
    "distribution:release:inspect": "node scripts/distribution-release.mjs inspect",
    "distribution:homebrew:render": "node scripts/distribution-homebrew.mjs render",
    "distribution:homebrew:verify-promotion": "node scripts/distribution-homebrew.mjs verify-promotion",
    "distribution:provider-lock:check": "node scripts/distribution-provider-lock.mjs check",
    "distribution:provider-lock:generate": "node scripts/distribution-provider-lock.mjs generate",
    "distribution:measure": "node scripts/distribution-manifest.mjs measure",
    "launcher:check": "cd launcher && test \"$(go env GOVERSION)\" = \"go1.26.4\" && go vet ./...",
    "launcher:test": "cd launcher && test \"$(go env GOVERSION)\" = \"go1.26.4\" && go test -race ./...",
    "ttfv:real": "node scripts/ttfv-real.mjs run",
    "ttfv:probe": "node scripts/ttfv-real.mjs probe",
    "ttfv:summary": "node scripts/ttfv-real.mjs summarize",
    "scripts:test": "node --test scripts/*.test.mjs",
    "python:test": "uv --project workers/automation run --extra dev pytest -q",
    "python:lint": "uv --project workers/automation run --extra dev ruff check .",
    "python:build": "uv --project workers/automation run --extra dev python -m build workers/automation",
    "check": "corepack pnpm --filter @jobctrl/contracts check && corepack pnpm --filter @jobctrl/api-client check && corepack pnpm api:check && corepack pnpm web:check && corepack pnpm extension:check && corepack pnpm demo-edge:check && corepack pnpm python:lint && corepack pnpm launcher:check",
    "test": "corepack pnpm scripts:test && corepack pnpm demo-edge:test && corepack pnpm api:test && corepack pnpm web:build && corepack pnpm extension:test && corepack pnpm extension:e2e && corepack pnpm python:test && corepack pnpm launcher:test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebarti/JobCtrl.git"
  },
  "keywords": [
    "job-search",
    "automation",
    "ai",
    "resume",
    "apply",
    "job-application"
  ],
  "author": "ebarti",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/ebarti/JobCtrl/issues"
  },
  "homepage": "https://github.com/ebarti/JobCtrl#readme",
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.35",
    "@tabler/icons-vue": "^3.44.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.1",
    "mermaid": "^11.16.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "@babel/core": "7.29.7",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.2",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "joi@<17.13.4": "17.13.4",
      "js-yaml": "4.2.0",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "uuid@<11.1.1": "11.1.1",
      "vite@>=7.0.0 <=7.3.4": "7.3.5",
      "vitepress>vite": "6.4.3",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  }
}
