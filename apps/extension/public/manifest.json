{
  "manifest_version": 3,
  "name": "JobHunter",
  "description": "Save job postings from the browser into the local JobHunter app.",
  "version": "0.3.0",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8766/*", "http://localhost:8766/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:8766 http://localhost:8766;"
  }
}
