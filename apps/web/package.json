{
  "name": "@jobctrl/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit --project tsconfig.json",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test-d": "vitest run --config vitest.types.config.ts",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:demo-workspace": "playwright test --config=e2e/demo-workspace.playwright.config.ts",
    "e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o ../../dist/web-storybook",
    "storybook:test": "start-server-and-test \"http-server ../../dist/web-storybook -p 6006 --silent\" http://127.0.0.1:6006 \"test-storybook --url http://127.0.0.1:6006\""
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@jobctrl/api-client": "workspace:*",
    "@jobctrl/contracts": "workspace:*",
    "@jobctrl/domain-types": "workspace:*",
    "@platejs/basic-nodes": "53.0.0",
    "@tabler/icons-react": "3.44.0",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-router": "^1.93.0",
    "@tanstack/react-router-devtools": "^1.93.0",
    "@tanstack/react-table": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "pdfjs-dist": "^5.7.284",
    "platejs": "53.1.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shadcn": "4.11.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@jobctrl/tsconfig": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/router-plugin": "^1.93.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "25.9.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.5",
    "axe-core": "^4.10.2",
    "axe-playwright": "^2.2.2",
    "better-sqlite3": "^12.9.0",
    "http-server": "^14.1.1",
    "jest-axe": "^9.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "msw-storybook-addon": "^2.0.7",
    "prettier": "^3.4.2",
    "start-server-and-test": "^3.0.2",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
