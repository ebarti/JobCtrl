#!/usr/bin/env bash
# scripts/dev — JobCtrl local dev fleet launcher.
#
# Runs or daemonizes the default temporal / api / web / worker fleet plus
# explicitly selected docs and demo processes. It tracks each by PID file under
# .dev/pids/, captures stdout+stderr to .dev/logs/, and starts from a clean
# owned process tree so stale local processes do not survive between launches.
# Each (re)start rotates the previous run's log to <name>.log.1 instead of
# truncating it, so a crash traceback survives the next launch.
#
# Usage:
#   scripts/dev run [name...]      Run named processes in the foreground
#   scripts/dev start [name...]    Start named processes (or all if none given)
#   scripts/dev stop  [name...]    Stop named (or all)
#   scripts/dev restart [name...]  Stop then start
#   scripts/dev status [name...]   Show pid, alive state, and worker health
#   scripts/dev logs <name>        tail -f the current log (prior run: <name>.log.1)
#   scripts/dev setup              Install/sync Node and Python dependencies
#   scripts/dev migrate-credentials Move persistent provider keys into the native store once
#   scripts/dev list               Print the process registry
#   scripts/dev help               Show this message

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEV_DIR="${JOBCTRL_DEV_DIR:-$ROOT/.dev}"
PID_DIR="$DEV_DIR/pids"
LOG_DIR="$DEV_DIR/logs"
mkdir -p "$PID_DIR" "$LOG_DIR"

# The default fleet remains the four application processes. Auxiliary docs and
# demo processes are opt-in so bare `scripts/dev run|start|stop|status` keeps
# its existing application-stack contract.
process_names() { echo "temporal api web worker"; }
known_process_names() { echo "$(process_names) docs demo-api demo-web"; }

process_command() {
  case "$1" in
    temporal) echo 'temporal server start-dev --db-filename "$JOBCTRL_TEMPORAL_DB"' ;;
    api)      echo "pnpm --filter @jobctrl/api dev" ;;
    web)      echo 'pnpm --filter @jobctrl/web exec vite --host 127.0.0.1 --port "$JOBCTRL_WEB_PORT"' ;;
    worker)   echo "uv --project workers/automation run jobctrl worker" ;;
    docs)     echo 'corepack pnpm exec vitepress dev docs --host 127.0.0.1 --port "$JOBCTRL_DOCS_PORT"' ;;
    demo-api) echo 'corepack pnpm --filter @jobctrl/demo-edge exec wrangler d1 migrations apply DEMO_TELEMETRY_DB --local --config wrangler.api.jsonc --persist-to "$JOBCTRL_DEMO_STATE_DIR" && exec corepack pnpm --filter @jobctrl/demo-edge exec wrangler dev --config wrangler.api.jsonc --local --ip 127.0.0.1 --port "$JOBCTRL_DEMO_API_PORT" --persist-to "$JOBCTRL_DEMO_STATE_DIR"' ;;
    demo-web) echo 'VITE_JOBCTRL_APP_MODE=demo VITE_DEMO_API_PROXY_TARGET="http://127.0.0.1:${JOBCTRL_DEMO_API_PORT}" exec corepack pnpm --filter @jobctrl/web exec vite --host 127.0.0.1 --port "$JOBCTRL_DEMO_WEB_PORT"' ;;
    *)        return 1 ;;
  esac
}

is_known() { process_command "$1" >/dev/null 2>&1; }

# Most registry entries are one long-lived command and can replace the launcher
# shell immediately. Demo API startup must first run a migration, and demo web
# starts with environment assignments, so those entries own their final `exec`
# inside the registered shell command instead.
process_shell_command() {
  local name="$1" cmd
  cmd=$(process_command "$name") || return 1
  case "$name" in
    demo-api|demo-web) echo "$cmd" ;;
    *)                 echo "exec $cmd" ;;
  esac
}

pid_file()  { echo "$PID_DIR/$1.pid"; }
log_file()  { echo "$LOG_DIR/$1.log"; }

# Rotate a process log before a (re)start so the previous run's output —
# including a crash traceback — survives as <log>.1 instead of being truncated
# away. Keeps a single generation of history (overwriting any older <log>.1).
# A fresh log is created by the appending start path; an empty log is left as-is
# so we don't churn a blank .1.
rotate_log() {
  local log="$1"
  if [[ -s "$log" ]]; then
    mv -f "$log" "$log.1"
  fi
}

read_pid() {
  local f
  f=$(pid_file "$1")
  [[ -f "$f" ]] || return 1
  cat "$f"
}

is_running() {
  local pid
  pid=$(read_pid "$1") || return 1
  kill -0 "$pid" 2>/dev/null
}

# Recursive process-tree kill. tsx-watch, vite, and `uv run` all spawn
# children — killing only the wrapper PID would leave node/python
# zombies bound to the dev ports.
kill_tree() {
  local pid="$1" sig="${2:-TERM}"
  local children
  children=$(pgrep -P "$pid" 2>/dev/null || true)
  for child in $children; do
    kill_tree "$child" "$sig"
  done
  kill "-$sig" "$pid" 2>/dev/null || true
}

collect_tree_pids() {
  local pid="$1"
  echo "$pid"
  local child
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do
    collect_tree_pids "$child"
  done
}

is_alive_pid() {
  local pid="$1" stat
  kill -0 "$pid" 2>/dev/null || return 1
  stat=$(ps -o stat= -p "$pid" 2>/dev/null | awk '{ print $1 }')
  [[ "$stat" != *Z* ]]
}

wait_pids_gone() {
  local pids="$1" ticks="$2" interval="$3"
  local i target alive
  for i in $(seq 1 "$ticks"); do
    alive=0
    for target in $pids; do
      if is_alive_pid "$target"; then
        alive=1
        break
      fi
    done
    [[ "$alive" -eq 0 ]] && return 0
    sleep "$interval"
  done
  return 1
}

stop_pid_tree() {
  local pid="$1"
  local pids target
  local wait_ticks="${JOBCTRL_STOP_WAIT_TICKS:-50}"
  local wait_interval="${JOBCTRL_STOP_WAIT_INTERVAL_SECONDS:-0.1}"
  local kill_wait_ticks="${JOBCTRL_KILL_WAIT_TICKS:-20}"
  pids=$(collect_tree_pids "$pid" | awk '/^[0-9]+$/ && $1 > 0 && !seen[$1]++')
  for target in $pids; do
    kill -TERM "$target" 2>/dev/null || true
  done

  # Wait for graceful shutdown before SIGKILL; tests can shorten this.
  wait_pids_gone "$pids" "$wait_ticks" "$wait_interval" && return 0

  for target in $pids; do
    kill -KILL "$target" 2>/dev/null || true
  done

  if ! wait_pids_gone "$pids" "$kill_wait_ticks" "$wait_interval"; then
    echo "dev: failed to stop process tree rooted at $pid" >&2
    return 1
  fi
}

ensure_not_running() {
  local name="$1"
  if is_running "$name"; then
    if [[ "${JOBCTRL_DEV_INNER:-}" == "1" ]]; then
      echo "dev: an unverified previous $name process is still tracked; stop the earlier development stack before starting." >&2
      return 1
    fi
    echo "$name: stopping previous process tree (pid $(read_pid "$name"))"
    stop_one "$name" >/dev/null
  else
    rm -f "$(pid_file "$name")"
  fi
}

# Load env files into the current shell so spawned children inherit
# secrets (Langfuse keys, Gemini keys, local web keys, etc.). Node and Python do
# not auto-source .env at startup — leaving this off would silently disable
# observability and optional local UI integrations in the dev fleet.
load_env_file() {
  local env_file
  for env_file in "${JOBCTRL_DIR:-$HOME/.jobctrl}/.env" "$ROOT/.env" "${JOBCTRL_USER_ENV_PATH:-$HOME/JobCtrl/.env}"; do
    [[ -f "$env_file" ]] || continue
    set -a
    # shellcheck disable=SC1090,SC1091
    source "$env_file"
    set +a
  done
}

temporal_path_conflict=0
set_default_env() {
  export JOBCTRL_DIR="${JOBCTRL_DIR:-$HOME/.jobctrl}"
  export JOBCTRL_API_HOST="${JOBCTRL_API_HOST:-127.0.0.1}"
  export JOBCTRL_API_PORT="${JOBCTRL_API_PORT:-8766}"
  export VITE_JOBCTRL_API_BASE_URL="${VITE_JOBCTRL_API_BASE_URL:-http://${JOBCTRL_API_HOST}:${JOBCTRL_API_PORT}}"
  export JOBCTRL_WEB_PORT="${JOBCTRL_WEB_PORT:-5173}"
  export JOBCTRL_DOCS_PORT="${JOBCTRL_DOCS_PORT:-4174}"
  export JOBCTRL_DEMO_API_PORT="${JOBCTRL_DEMO_API_PORT:-8787}"
  export JOBCTRL_DEMO_WEB_PORT="${JOBCTRL_DEMO_WEB_PORT:-5174}"
  export JOBCTRL_DEMO_STATE_DIR="${JOBCTRL_DEMO_STATE_DIR:-$DEV_DIR/demo/wrangler}"
  # New workspaces use the installed launcher's history path. Preserve the
  # earlier source-only location when it is the sole existing history; never
  # silently choose between two histories belonging to the same app database.
  temporal_path_conflict=0
  if [[ -z "${JOBCTRL_TEMPORAL_DB:-}" ]]; then
    local native_temporal="$JOBCTRL_DIR/temporal.db"
    local legacy_temporal="$JOBCTRL_DIR/temporal/temporal.db"
    local db_path suffix
    for db_path in "$native_temporal" "$legacy_temporal"; do
      if [[ ! -e "$db_path" && ! -L "$db_path" ]]; then
        for suffix in -wal -shm -journal; do
          if [[ -e "$db_path$suffix" || -L "$db_path$suffix" ]]; then
            temporal_path_conflict=1
          fi
        done
      fi
    done
    if [[ ( -e "$native_temporal" || -L "$native_temporal" ) && ( -e "$legacy_temporal" || -L "$legacy_temporal" ) ]]; then
      temporal_path_conflict=1
      export JOBCTRL_TEMPORAL_DB="$native_temporal"
    elif [[ -e "$legacy_temporal" || -L "$legacy_temporal" ]]; then
      export JOBCTRL_TEMPORAL_DB="$legacy_temporal"
    else
      export JOBCTRL_TEMPORAL_DB="$native_temporal"
    fi
  fi
  mkdir -p "$(dirname "$JOBCTRL_TEMPORAL_DB")" "$JOBCTRL_DEMO_STATE_DIR"
}

start_detached_command() {
  local cmd="$1" log="$2"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$ROOT" "$log" "$cmd" <<'PY'
import os
import sys

root, log_path, command = sys.argv[1:]
read_fd, write_fd = os.pipe()
pid = os.fork()

if pid:
    os.close(write_fd)
    with os.fdopen(read_fd) as pipe:
        detached_pid = pipe.read().strip()
    _, status = os.waitpid(pid, 0)
    if status != 0 or not detached_pid:
        sys.exit(os.waitstatus_to_exitcode(status))
    print(detached_pid)
    sys.exit(0)

os.close(read_fd)
try:
    os.setsid()
    detached_pid = os.fork()
    if detached_pid:
        os.write(write_fd, str(detached_pid).encode("utf-8"))
        os.close(write_fd)
        os._exit(0)

    os.close(write_fd)
    os.chdir(root)
    stdin_fd = os.open(os.devnull, os.O_RDONLY)
    log_fd = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.dup2(stdin_fd, 0)
    os.dup2(log_fd, 1)
    os.dup2(log_fd, 2)
    if stdin_fd > 2:
        os.close(stdin_fd)
    if log_fd > 2:
        os.close(log_fd)
    os.execvp("bash", ["bash", "-c", command])
except Exception:
    os._exit(127)
PY
    return 0
  fi

  # Fallback for minimal shells. Python-backed starts detach the child from the
  # launching process tree; plain nohup is retained when Python is unavailable.
  ( cd "$ROOT" && exec nohup bash -c "$cmd" ) </dev/null >>"$log" 2>&1 &
  echo "$!"
}

start_one() {
  local name="$1"
  if ! is_known "$name"; then
    echo "dev: unknown process '$name' (try: $(known_process_names))" >&2
    return 1
  fi
  ensure_not_running "$name"
  local cmd log
  cmd=$(process_shell_command "$name")
  log=$(log_file "$name")
  rotate_log "$log"
  local pid
  pid=$(start_detached_command "$cmd" "$log")
  echo "$pid" > "$(pid_file "$name")"
  echo "$name: started (pid $pid, logs $log)"
}

read_log_url() {
  local file="$1" pattern="$2"
  [[ -f "$file" ]] || return 1
  grep -Eo "$pattern" "$file" 2>/dev/null | tail -n 1 || true
}

wait_for_log_url() {
  local file="$1" pattern="$2"
  local ticks="${JOBCTRL_BINDING_WAIT_TICKS:-50}"
  local interval="${JOBCTRL_BINDING_WAIT_INTERVAL_SECONDS:-0.1}"
  local i url
  for i in $(seq 1 "$ticks"); do
    url=$(read_log_url "$file" "$pattern")
    if [[ -n "$url" ]]; then
      echo "$url"
      return 0
    fi
    sleep "$interval"
  done
  return 1
}

print_binding_for() {
  local name="$1" url
  case "$name" in
    api)
      url=$(read_log_url "$(log_file "$name")" 'http://[^[:space:]]+')
      if [[ -n "$url" ]]; then
        echo "api: $url"
      else
        echo "api: http://${JOBCTRL_API_HOST}:${JOBCTRL_API_PORT} (configured)"
      fi
      ;;
    web)
      url=$(wait_for_log_url "$(log_file "$name")" 'http://127\.0\.0\.1:[0-9]+/?' || true)
      if [[ -z "$url" ]]; then
        url=$(read_log_url "$(log_file "$name")" 'http://localhost:[0-9]+/?')
      fi
      if [[ -n "$url" ]]; then
        echo "web: $url"
      else
        echo "web: http://127.0.0.1:${JOBCTRL_WEB_PORT}/ (requested; startup log pending)"
      fi
      ;;
    docs)
      url=$(wait_for_log_url "$(log_file "$name")" 'http://127\.0\.0\.1:[0-9]+/?' || true)
      if [[ -z "$url" ]]; then
        url=$(read_log_url "$(log_file "$name")" 'http://localhost:[0-9]+/?')
      fi
      if [[ -n "$url" ]]; then
        echo "docs: $url"
      else
        echo "docs: http://127.0.0.1:${JOBCTRL_DOCS_PORT}/ (requested; startup log pending)"
      fi
      ;;
    demo-api)
      url=$(wait_for_log_url "$(log_file "$name")" 'http://127\.0\.0\.1:[0-9]+/?' || true)
      if [[ -z "$url" ]]; then
        url=$(read_log_url "$(log_file "$name")" 'http://localhost:[0-9]+/?')
      fi
      if [[ -n "$url" ]]; then
        echo "demo-api: $url"
      else
        echo "demo-api: http://127.0.0.1:${JOBCTRL_DEMO_API_PORT}/ (requested; startup log pending)"
      fi
      ;;
    demo-web)
      url=$(wait_for_log_url "$(log_file "$name")" 'http://127\.0\.0\.1:[0-9]+/?' || true)
      if [[ -z "$url" ]]; then
        url=$(read_log_url "$(log_file "$name")" 'http://localhost:[0-9]+/?')
      fi
      if [[ -n "$url" ]]; then
        echo "demo-web: $url"
      else
        echo "demo-web: http://127.0.0.1:${JOBCTRL_DEMO_WEB_PORT}/ (requested; startup log pending)"
      fi
      ;;
    temporal)
      echo "temporal: grpc 127.0.0.1:7233, ui http://127.0.0.1:8233"
      ;;
  esac
}

print_binding_summary() {
  local printed=0 n
  for n in "$@"; do
    case "$n" in
      api|web|temporal|docs|demo-api|demo-web)
        if [[ "$printed" -eq 0 ]]; then
          echo "dev: bindings"
          printed=1
        fi
        print_binding_for "$n"
        ;;
    esac
  done
}

run_pids=()
run_names=()
run_cleaned=0

run_cleanup() {
  [[ "$run_cleaned" -eq 0 ]] || return 0
  run_cleaned=1
  local i name pid
  for i in "${!run_pids[@]}"; do
    name="${run_names[$i]}"
    pid="${run_pids[$i]}"
    if stop_pid_tree "$pid"; then
      rm -f "$(pid_file "$name")"
    fi
  done
}

start_run_one() {
  local name="$1"
  if ! is_known "$name"; then
    echo "dev: unknown process '$name' (try: $(known_process_names))" >&2
    return 1
  fi
  ensure_not_running "$name"
  local cmd log
  cmd=$(process_shell_command "$name")
  log=$(log_file "$name")
  rotate_log "$log"
  (
    set -o pipefail
    cd "$ROOT"
    bash -c "$cmd" 2>&1 \
      | tee -a "$log" \
      | awk -v name="$name" '{ print "[" name "] " $0; fflush(); }'
  ) &
  local pid=$!
  echo "$pid" > "$(pid_file "$name")"
  run_names+=("$name")
  run_pids+=("$pid")
  echo "$name: running in foreground (pid $pid, logs $log)"
}

stop_one() {
  local name="$1"
  if ! is_known "$name"; then
    echo "dev: unknown process '$name'" >&2
    return 1
  fi
  if ! is_running "$name"; then
    rm -f "$(pid_file "$name")"
    echo "$name: not running"
    return 0
  fi
  local pid
  pid=$(read_pid "$name")
  stop_pid_tree "$pid" || return 1
  rm -f "$(pid_file "$name")"
  echo "$name: stopped"
}

prepare_runtime() {
  load_env_file
  set_default_env
  local name
  if [[ "$temporal_path_conflict" -eq 1 ]]; then
    for name in "$@"; do
      case "$name" in
        temporal|api|worker)
          echo "dev: conflicting Temporal histories or orphaned SQLite companions exist for this workspace; preserve them and resolve their ownership before starting." >&2
          return 1
          ;;
      esac
    done
  fi
  # When switching a managed workspace, probe after its verified owner stops.
  if [[ "${JOBCTRL_DEV_DEFER_API_PROBE:-}" != "1" ]]; then
    check_api_collision "$@"
  fi
  for name in "$@"; do
    [[ "$name" == "web" ]] || continue
    echo "dev: building browser extension"
    if ! ( cd "$ROOT" && corepack pnpm extension:build ); then
      echo "dev: extension build failed; existing processes were left running" >&2
      return 1
    fi
    echo "extension: $ROOT/dist/extension"
    echo "extension: open chrome://extensions, enable Developer mode, and Load unpacked from that path."
    echo "extension: if already loaded, click Reload on its card; reload open application tabs after each build."
    return 0
  done
}

check_api_collision() {
  local name
  # A different checkout or installed app can serve the same port. Never
  # silently connect the web app to that unrelated API.
  for name in "$@"; do
    if [[ "$name" == "api" ]] && ! is_running api && command -v curl >/dev/null 2>&1; then
      if curl -sS --max-time 1 -o /dev/null "http://${JOBCTRL_API_HOST}:${JOBCTRL_API_PORT}/v1/health" 2>/dev/null; then
        echo "dev: another API is responding on ${JOBCTRL_API_HOST}:${JOBCTRL_API_PORT}; stop that runtime or select separate bindings before starting." >&2
        return 1
      fi
    fi
  done
}

schema_is_incompatible() {
  local database="${JOBCTRL_DB_PATH:-$JOBCTRL_DIR/jobctrl.db}" result
  [[ -f "$database" && -f "$ROOT/scripts/dev-schema-check.py" ]] || return 1
  result=$(PYTHONDONTWRITEBYTECODE=1 python3 "$ROOT/scripts/dev-schema-check.py" "$database" 2>/dev/null) || return 1
  [[ "$result" == "incompatible" ]]
}

# Keep the diagnostic API and web UI available without starting a worker or
# Temporal against a database that the runtime refuses to open.
select_default_targets() {
  if schema_is_incompatible; then
    echo "dev: incompatible workspace database; starting the diagnostic API and web interface only."
    if [[ "${JOBCTRL_DEV_INNER:-}" == "1" ]]; then
      if is_running worker || is_running temporal; then
        echo "dev: stop the unverified earlier development stack before starting diagnostics." >&2
        return 1
      fi
    else
      stop_one worker
      stop_one temporal
    fi
    targets=(api web)
  fi
}

reject_incompatible_worker_targets() {
  schema_is_incompatible || return 0
  local name
  for name in "$@"; do
    case "$name" in
      temporal|worker)
        echo "dev: this workspace database needs a compatible upgrade; start the default fleet for diagnostics instead of starting $name." >&2
        return 1
        ;;
    esac
  done
}

cmd_start() {
  local mode="$1"
  shift
  local targets=("$@")
  local default_fleet=0
  if [[ ${#targets[@]} -eq 0 ]]; then
    default_fleet=1
    for n in $(process_names); do targets+=("$n"); done
  fi
  prepare_runtime "${targets[@]}"
  if [[ "$default_fleet" -eq 0 ]]; then
    reject_incompatible_worker_targets "${targets[@]}"
  else
    select_default_targets
  fi
  if [[ "$mode" == "restart" ]]; then
    cmd_stop "${targets[@]}"
  fi
  for n in "${targets[@]}"; do start_one "$n"; done
  print_binding_summary "${targets[@]}"
}

cmd_run() {
  local targets=("$@")
  local default_fleet=0
  if [[ ${#targets[@]} -eq 0 ]]; then
    default_fleet=1
    for n in $(process_names); do targets+=("$n"); done
  fi
  if [[ "${JOBCTRL_DEV_PREPARED:-}" != "1" ]]; then
    prepare_runtime "${targets[@]}"
  fi
  if [[ "$default_fleet" -eq 0 ]]; then
    reject_incompatible_worker_targets "${targets[@]}"
  else
    select_default_targets
  fi

  trap 'run_cleanup; exit 130' INT
  trap 'run_cleanup; exit 143' TERM
  trap 'run_cleanup' EXIT

  local n
  for n in "${targets[@]}"; do start_run_one "$n"; done

  echo "dev: foreground run active; press Ctrl-C to stop ($(IFS=,; echo "${targets[*]}"))"

  # The native source controller provides this private readiness pipe only
  # inside its authenticated workspace scope.
  if [[ "${JOBCTRL_DEV_READY_FD:-}" == "3" ]]; then
    printf 'source-ready\n' >&3
    exec 3>&-
  fi

  local i name pid status
  while true; do
    for i in "${!run_pids[@]}"; do
      name="${run_names[$i]}"
      pid="${run_pids[$i]}"
      if ! kill -0 "$pid" 2>/dev/null; then
        status=0
        wait "$pid" || status=$?
        echo "dev: $name exited (status $status); stopping foreground run" >&2
        run_cleanup
        exit "$status"
      fi
    done
    sleep 1
  done
}

# The macOS source fleet uses the same native workspace scope as an installed
# release. Detached starts keep that controller alive instead of daemonizing
# each database writer independently.
source_control() {
  if ! command -v go >/dev/null 2>&1; then
    echo "dev: Go 1.24 or newer is required for shared workspace ownership; run scripts/install." >&2
    return 1
  fi
  go -C "$ROOT/launcher" run ./cmd/jobctrl-source "$1" "$ROOT"
}

workspace_targets() {
  [[ $# -gt 0 ]] || return 0
  local name
  for name in "$@"; do
    case "$name" in temporal|api|worker) return 0 ;; esac
  done
  return 1
}

prepare_source_run() {
  local targets=("$@") name
  if [[ ${#targets[@]} -eq 0 ]]; then
    for name in $(process_names); do targets+=("$name"); done
  fi
  JOBCTRL_DEV_DEFER_API_PROBE=1
  prepare_runtime "${targets[@]}"
  unset JOBCTRL_DEV_DEFER_API_PROBE
  source_control switch
  check_api_collision "${targets[@]}"
  export JOBCTRL_DEV_PREPARED=1
}

cmd_start_source() {
  local targets=("$@") name command log pid i
  if [[ ${#targets[@]} -eq 0 ]]; then
    for name in $(process_names); do targets+=("$name"); done
  fi
  prepare_source_run "$@"
  log="$LOG_DIR/source-supervisor.log"
  rotate_log "$log"
  printf -v command 'exec %q run' "$ROOT/scripts/dev"
  for name in "$@"; do
    printf -v command '%s %q' "$command" "$name"
  done
  pid=$(start_detached_command "$command" "$log")
  for i in $(seq 1 600); do
    if [[ -f "$log" ]] && grep -Fq 'dev: foreground run active;' "$log"; then
      echo "dev: detached source stack started (logs $log)"
      if grep -Fq 'dev: incompatible workspace database;' "$log"; then
        echo "dev: incompatible workspace database; the diagnostic API and web interface are running without the worker and Temporal."
      fi
      local running=()
      for name in "${targets[@]}"; do
        if is_running "$name"; then running+=("$name"); fi
      done
      print_binding_summary "${running[@]}"
      return 0
    fi
    if ! is_alive_pid "$pid"; then
      echo "dev: source stack failed to start; see $log" >&2
      return 1
    fi
    sleep 0.1
  done
  echo "dev: source stack has not reported startup; see $log" >&2
  return 1
}

cmd_stop() {
  local targets=("$@")
  if [[ ${#targets[@]} -eq 0 ]]; then
    for n in $(process_names); do targets+=("$n"); done
  fi
  for n in "${targets[@]}"; do stop_one "$n"; done
}

worker_health_status() {
  if ! command -v curl >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
    echo "unknown"
    return 0
  fi

  local payload status
  payload=$(
    curl -fsS --max-time 1 \
      "http://${JOBCTRL_API_HOST}:${JOBCTRL_API_PORT}/v1/health" 2>/dev/null || true
  )
  if [[ -z "$payload" ]]; then
    echo "unknown"
    return 0
  fi

  status=$(
    python3 -c 'import json, sys; print((json.load(sys.stdin).get("worker") or {}).get("status") or "unknown")' \
      <<< "$payload" 2>/dev/null || true
  )
  echo "${status:-unknown}"
}

api_health_status() {
  if ! command -v curl >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
    echo "unknown"
    return 0
  fi
  local payload status
  payload=$(curl -sS --max-time 1 "http://${JOBCTRL_API_HOST}:${JOBCTRL_API_PORT}/v1/health" 2>/dev/null || true)
  [[ -n "$payload" ]] || { echo "unknown"; return 0; }
  status=$(python3 -c 'import json,sys; d=json.load(sys.stdin); e=d.get("error"); print("migration" if e=="database_migration_required" else "incompatible" if e=="database_schema_incompatible" else "healthy" if d.get("ok") is True else "unknown")' <<< "$payload" 2>/dev/null || true)
  echo "${status:-unknown}"
}

cmd_status() {
  load_env_file
  set_default_env
  local targets=("$@")
  if [[ ${#targets[@]} -eq 0 ]]; then
    for n in $(process_names); do targets+=("$n"); done
  fi
  printf "%-10s %-8s %-8s %-10s %s\n" NAME STATE PID HEALTH LOG
  for n in "${targets[@]}"; do
    if ! is_known "$n"; then
      echo "dev: unknown process '$n' (try: $(known_process_names))" >&2
      return 1
    fi
    local state pid health log
    if is_running "$n"; then
      state="up"
      pid=$(read_pid "$n")
    else
      state="down"
      pid="-"
    fi
    health="-"
    if [[ "$n" == "api" && "$state" == "up" ]]; then
      health=$(api_health_status)
    elif [[ "$n" == "worker" && "$state" == "up" ]]; then
      health=$(worker_health_status)
    fi
    log=$(log_file "$n")
    printf "%-10s %-8s %-8s %-10s %s\n" "$n" "$state" "$pid" "$health" "$log"
  done
}

cmd_logs() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "dev: logs requires a process name (try: $(known_process_names))" >&2
    exit 2
  fi
  if ! is_known "$name"; then
    echo "dev: unknown process '$name'" >&2
    exit 2
  fi
  local log
  log=$(log_file "$name")
  [[ -f "$log" ]] || : > "$log"
  exec tail -F "$log"
}

cmd_setup() {
  ( cd "$ROOT" && corepack pnpm install )
  ( cd "$ROOT" && uv --project workers/automation sync --extra dev )
}

cmd_migrate_credentials() {
  local app_dir="${JOBCTRL_DIR:-$HOME/.jobctrl}"
  local user_env="${JOBCTRL_USER_ENV_PATH:-$HOME/JobCtrl/.env}"
  (
    cd "$ROOT"
    uv --project workers/automation run jobctrl credentials migrate \
      --env-file "$app_dir/.env" \
      --env-file "$ROOT/.env" \
      --env-file "$user_env" \
      --marker "$app_dir/.native-credentials-migrated.json"
  )
}

cmd_list() {
  for n in $(known_process_names); do
    printf "%-10s %s\n" "$n" "$(process_command "$n")"
  done
}

cmd_help() {
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
}

main() {
  local sub="${1:-help}"
  shift || true
  [[ "${1:-}" == "--" ]] && shift
  if [[ "$sub" != "run" ]]; then
    unset JOBCTRL_DEV_INNER JOBCTRL_DEV_PREPARED
  fi
  if [[ "$sub" == "run" && "${JOBCTRL_DEV_INNER:-}" == "1" && "$(uname -s)" == "Darwin" ]] && workspace_targets "$@"; then
    # An inherited flag alone cannot authorize an untracked database writer.
    source_control verify
  fi
  if [[ "${JOBCTRL_DEV_INNER:-}" != "1" && "$(uname -s)" == "Darwin" ]] && workspace_targets "$@"; then
    case "$sub" in
      run)
        if [[ "${JOBCTRL_DEV_PREPARED:-}" != "1" ]]; then prepare_source_run "$@"; fi
        exec go -C "$ROOT/launcher" run ./cmd/jobctrl-source run "$ROOT" "$@"
        ;;
      start|restart)
        cmd_start_source "$@"
        return
        ;;
      stop)
        load_env_file
        set_default_env
        source_control stop
        ;;
    esac
  fi
  case "$sub" in
    run)     cmd_run "$@" ;;
    start|restart) cmd_start "$sub" "$@" ;;
    stop)    cmd_stop "$@" ;;
    status)  cmd_status "$@" ;;
    logs)    cmd_logs "$@" ;;
    setup)   cmd_setup ;;
    migrate-credentials) cmd_migrate_credentials ;;
    list)    cmd_list ;;
    help|-h|--help) cmd_help ;;
    *) echo "dev: unknown command '$sub'" >&2; cmd_help; exit 2 ;;
  esac
}

main "$@"
