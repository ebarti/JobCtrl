{
  "schemaVersion": 1,
  "platform": "darwin-arm64",
  "components": [
    {
      "id": "jobctrl-launcher",
      "path": "launcher"
    },
    {
      "id": "jobctrl-web",
      "path": "web"
    },
    {
      "id": "jobctrl-worker",
      "path": "worker"
    },
    {
      "id": "jobctrl-release-metadata",
      "path": "release"
    },
    {
      "id": "node-runtime",
      "path": "node"
    },
    {
      "id": "python-runtime",
      "path": "python"
    },
    {
      "id": "temporal-runtime",
      "path": "temporal"
    },
    {
      "id": "pdfjs-renderer",
      "path": "pdfjs"
    },
    {
      "id": "playwright-python",
      "path": "playwright-python"
    },
    {
      "id": "chromium-core",
      "path": "chromium"
    },
    {
      "id": "playwright-mcp",
      "path": "playwright-mcp"
    }
  ],
  "embeddedComponents": [
    {
      "id": "font-jetbrains-mono",
      "includedIn": "jobctrl-web",
      "prefixes": [
        "web/assets/jetbrains-mono-"
      ]
    },
    {
      "id": "font-geist",
      "includedIn": "jobctrl-web",
      "prefixes": [
        "web/assets/geist-"
      ]
    },
    {
      "id": "system-browser-adapter",
      "includedIn": "jobctrl-worker",
      "paths": [
        "worker/site-packages/jobctrl/browser_capabilities.py",
        "worker/site-packages/jobctrl/native_browser.py",
        "worker/site-packages/jobctrl/native_runtime_config.py"
      ]
    }
  ],
  "sharedComponentFiles": [
    {
      "id": "pdfjs-renderer",
      "includedIn": "jobctrl-web",
      "prefixes": [
        "web/assets/pdf-",
        "web/assets/pdf.worker-"
      ]
    }
  ],
  "standardInputs": {
    "webAssets": "dist/web",
    "workerWheelDirectory": "dist",
    "playwrightMcpRuntime": "packaging/distribution/playwright-mcp"
  },
  "envelopeExclusions": [
    "manifest.json",
    "manifest.sig"
  ]
}
